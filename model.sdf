<?xml version="1.0"?>
<!--
  iris_with_camera: orijinal iris_with_ardupilot modelini DEGISTIRMEDEN
  sarmalayan model. Uzerine asagi bakan bir kamera ekler.

  Neden sarmalayici?
    - ArduPilot eklentisi ve motor ayarlari orijinal modelde kalir.
    - Kamera sorun cikarirsa dunyada iris_with_ardupilot'a donmek yeterli.

  >>> KONTROL ET (tek satir): asagidaki <parent> satiri
        iris_demo::iris::base_link
      seklinde. "iris_demo" = iris_with_ardupilot/model.sdf icindeki <model name>,
      "iris" = onun icine include edilen modelin adi. Senin kurulumunda farkliysa
      sadece o satiri duzelt. Kontrol komutu:
        grep -n -E "<model name|<uri>" \
          $(find ~ -path "*models/iris_with_ardupilot/model.sdf" 2>/dev/null | head -1)
-->
<sdf version="1.6">
  <model name="iris_with_camera">

    <include>
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <link name="down_camera_link">
      <!-- Govdenin 6 cm altinda, tam ortada. Link'in kendisi DONDURULMEZ;
           bakis yonu asagidaki sensor pose'u ile verilir. -->
      <pose>0 0 -0.06 0 0 0</pose>
      <gravity>true</gravity>

      <!-- Kutle verilmezse Gazebo varsayilan 1 kg atar ve drone agirlasir. -->
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>

      <visual name="body">
        <geometry>
          <box>
            <size>0.03 0.03 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <sensor name="down_camera" type="camera">
        <!--
          Kamera kendi +X ekseni boyunca bakar. Pitch +90 derece (1.5708 rad)
          +X'i asagiya (-Z) cevirir. Sonuc:
            goruntunun USTU    = drone'un ONU
            goruntunun SAGI    = drone'un SAG tarafi
        -->
        <pose>0 0 0 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <camera name="down_camera">
          <!-- 80 derece yatay gorus alani. GERCEK KAMERANLA ESLESTIR. -->
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>150</far>
          </clip>
        </camera>

        <plugin name="down_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/drone</namespace>
          </ros>
          <camera_name>down_camera</camera_name>
          <frame_name>down_camera_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="down_camera_joint" type="fixed">
      <parent>iris_demo::iris::base_link</parent>
      <child>down_camera_link</child>
    </joint>

  </model>
</sdf>
